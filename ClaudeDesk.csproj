<!-- 프로젝트 설정: .NET 8 WPF 앱, Windows 전용으로 빌드. 실행 파일 이름은 고양이 이름(GAFIL) -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>GAFIL</AssemblyName>
    <!-- 버전: GitHub Releases 태그(v1.1.0)와 맞춤. 업데이트 확인에 사용 -->
    <Version>1.5.0</Version>
    <RootNamespace>ClaudeDesk</RootNamespace>
    <ApplicationIcon>gafil.ico</ApplicationIcon>
    <!-- 모니터별 DPI 인식(Per-Monitor V2): 화면 캡처·마우스 좌표를 실제 픽셀로 일관되게 (app.manifest 설명 참고) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- .NET 런타임(runtime)을 exe와 함께 묶음: 받는 사람이 .NET을 따로 설치하지 않아도 실행됨
         (런타임이 없는 PC에서 exe를 실행하면 hostfxr.dll not found로 바로 꺼짐) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 3단계: CPU 사용률(성능 카운터) 읽기용 -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <!-- 3단계: NVIDIA가 아닌 GPU의 이름 읽기용 (WMI) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- 5단계: GAFIL 화면 조작 — 화면 캡처와 JPEG 인코딩 (GDI+) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
