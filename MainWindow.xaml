<!-- 투명 항상 위 창. 평소에는 고양이(80x60) + 시스템 정보 한 줄 크기이고, 말풍선을 열면 위로 커짐.
     투명한 부분은 클릭이 아래 창으로 그대로 통과함 -->
<Window x:Class="ClaudeDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GAFIL"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Malgun Gothic, Segoe UI"
        Width="80" Height="60">

    <Window.Resources>
        <!-- 색: 따뜻한 크림색 바탕 + 고양이 외곽선과 같은 진갈색 -->
        <SolidColorBrush x:Key="Paper" Color="#FFFBF5"/>
        <SolidColorBrush x:Key="Ink" Color="#3A2218"/>
        <SolidColorBrush x:Key="Accent" Color="#D9653B"/>
        <SolidColorBrush x:Key="Muted" Color="#9A8274"/>
        <SolidColorBrush x:Key="Chip" Color="#F3E6DC"/>
        <SolidColorBrush x:Key="ErrorInk" Color="#B33A2A"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 머리줄 아이콘 버튼: 배경 없이, 마우스를 올리면 옅은 배경 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F3E6DC"/>
                                <Setter Property="Foreground" Value="#3A2218"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 말풍선: 기본은 접힘. 고양이를 클릭하면 나타남. 아래 꼬리가 고양이를 가리킴 -->
        <StackPanel x:Name="Bubble" Grid.Row="0" Visibility="Collapsed"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2">
            <Border Width="320" Background="{StaticResource Paper}"
                    BorderBrush="{StaticResource Ink}" BorderThickness="2"
                    CornerRadius="8" Padding="14,8,10,12">
                <DockPanel>
                    <!-- 머리줄: 이름 + 상태 + 버튼들. 더블클릭하면 Claude 앱에서 이어하기 -->
                    <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="0,0,0,6" Background="Transparent">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="StopButton" Style="{StaticResource IconButton}" Content="&#xE71A;"
                                    ToolTip="하던 일 멈추기" Visibility="Collapsed" Foreground="{StaticResource ErrorInk}"/>
                            <Button x:Name="HandoffButton" Style="{StaticResource IconButton}" Content="&#xE8A7;"
                                    ToolTip="Claude 앱에서 이어서 대화하기 (말풍선 머리줄 더블클릭과 같음)"/>
                            <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Content="&#xE740;"
                                    ToolTip="크게 보기 (위로 길게)"/>
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;"
                                    ToolTip="닫기 (Esc)"/>
                        </StackPanel>
                        <TextBlock Text="GAFIL" FontWeight="Bold" FontSize="13.5"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                   ToolTip="Genius Autonomous Feline Intelligence &amp; Laziness"/>
                        <TextBlock x:Name="StatusText" Margin="8,1,0,0" FontSize="11"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- 입력창: 둥근 상자 + 비었을 때 안내 문구 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,4,0">
                        <Border Background="White" CornerRadius="6"
                                BorderBrush="#E3D2C5" BorderThickness="1.5" Padding="8,6">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="GAFIL에게 시킬 일 입력하고 Enter"
                                           Foreground="#BBA899" FontSize="13" IsHitTestVisible="False"/>
                                <TextBox x:Name="Input" KeyDown="Input_KeyDown" TextChanged="Input_TextChanged"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         FontSize="13" Foreground="{StaticResource Ink}"
                                         CaretBrush="{StaticResource Accent}"
                                         TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                        <TextBlock Margin="2,5,0,0" FontSize="10.5" Foreground="#B9A797"
                                   Text="Enter 보내기 · Shift+Enter 줄바꿈 · Esc 닫기"/>
                    </StackPanel>

                    <!-- 대화 기록: 길면 스크롤. 크게 보기면 화면 위쪽까지 늘어남 -->
                    <!-- Focusable=False: 스크롤 영역이 클릭을 '처리됨'으로 바꿔 더블클릭(앱 전환)을 삼키지 않게, 입력창 포커스도 유지 -->
                    <ScrollViewer x:Name="ChatScroll" MaxHeight="240" Padding="0,0,4,0" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChatPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 말풍선 꼬리: 테두리 위에 살짝 겹쳐서 이음새가 보이지 않게 함 -->
            <Path Data="M0,0 L9,9 L18,0" Fill="{StaticResource Paper}" Stroke="{StaticResource Ink}"
                  StrokeThickness="2" HorizontalAlignment="Center" Margin="0,-2.5,0,0"/>
        </StackPanel>

        <!-- 3단계: 대화하지 않을 때 고양이 위에 CPU/GPU 한 줄 표시 -->
        <Border x:Name="StatsPill" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center"
                Background="#D92B1A12" CornerRadius="9" Padding="8,2" Margin="0,0,0,3">
            <TextBlock x:Name="StatsText" FontSize="10.5" Foreground="#FBE3D0"
                       FontFamily="Cascadia Mono, Consolas, Malgun Gothic"/>
        </Border>

        <!-- 고양이: 칸(Rectangle)은 코드에서 그림. 왼쪽 클릭: 말풍선, 오른쪽 클릭: 메뉴 -->
        <Canvas x:Name="Cat" Grid.Row="2"
                Width="80" Height="60"
                HorizontalAlignment="Center"
                SnapsToDevicePixels="True"
                Background="Transparent" Cursor="Hand">
            <Canvas.ContextMenu>
                <ContextMenu x:Name="CatMenu">
                    <MenuItem x:Name="MenuTalk" Header="GAFIL과 대화"/>
                    <MenuItem x:Name="MenuNewChat" Header="새 대화 시작"/>
                    <Separator/>
                    <MenuItem x:Name="MenuStats" Header="CPU/GPU 표시" IsCheckable="True"/>
                    <MenuItem x:Name="MenuAutoStart" Header="Windows 시작 시 자동 실행" IsCheckable="True"/>
                    <Separator/>
                    <MenuItem x:Name="MenuSettings" Header="설정 파일 열기 (허용 폴더 등)"/>
                    <MenuItem x:Name="MenuLog" Header="명령 로그 열기"/>
                    <Separator/>
                    <MenuItem x:Name="MenuExit" Header="GAFIL 끄기"/>
                </ContextMenu>
            </Canvas.ContextMenu>
        </Canvas>
    </Grid>
</Window>
